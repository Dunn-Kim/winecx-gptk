From b4334d41e5d1f58b14ad090c8778bfb612ff6de0 Mon Sep 17 00:00:00 2001
From: Dong Hwan Kim <karmaddee@gmail.com>
Date: Tue, 24 Nov 2026 11:48:41 +0900
Subject: [PATCH] ntdll: read the performance counter without a syscall under
 Rosetta.

RtlQueryPerformanceCounter always called NtQueryPerformanceCounter, a full
trip into unix code to read mach_continuous_time. Under Rosetta 2, rdtsc
counts that same clock in nanoseconds: over 5 million back-to-back reads on
an M5 Pro with macOS 27.0.1, rdtsc, mach_continuous_time and rdtsc again
never came out of order.

When the first process of a session fills KUSER_SHARED_DATA, check that 1000
such triples are in order, which fails on Intel, where rdtsc counts CPU
cycles and runs ahead. If they are, set Spare, a field Windows leaves unused,
as a Wine-private flag. RtlQueryPerformanceCounter then divides rdtsc by 100
itself, so QueryPerformanceFrequency stays at 10 MHz and its values still mix
with NtQueryPerformanceCounter's.

QpcBypassEnabled, QpcFrequency, QpcShift and QpcBias stay unset. On Windows
they would say that (rdtsc + QpcBias) >> QpcShift counts at QpcFrequency,
and no shift turns nanoseconds into 100 ns units.

In tests/qpcprobe.c (winecx-gptk), a million calls alternating between
QueryPerformanceCounter and NtQueryPerformanceCounter never went backwards,
a 500 ms Sleep read as about 500 ms, and a QueryPerformanceCounter call went
from about 40 ns to about 9 ns.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/time.c         | 12 ++++++++++++
 dlls/ntdll/unix/virtual.c | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 5a96a1e..a83dacd 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -381,6 +381,18 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if (defined(__i386__) || defined(__x86_64__)) && !defined(__arm64ec__)
+    /* Spare is set only under Rosetta 2, where rdtsc counts the nanoseconds that
+     * NtQueryPerformanceCounter reads with a syscall (virtual_init_user_shared_data) */
+    if (user_shared_data->Spare)
+    {
+        ULONG lo, hi;
+
+        __asm__ __volatile__( "rdtsc" : "=a" (lo), "=d" (hi) );
+        counter->QuadPart = (((ULONGLONG)hi << 32) | lo) / (1000000000 / TICKSPERSEC);
+        return TRUE;
+    }
+#endif
     NtQueryPerformanceCounter( counter, NULL );
     return TRUE;
 }
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index b6f6a05..aaaab7d 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -66,6 +66,7 @@
 #if defined(__APPLE__)
 #define host_page_size mac_host_page_size
 # include <mach/mach_init.h>
+# include <mach/mach_time.h>
 # include <mach/mach_vm.h>
 # include <mach/task.h>
 # include <mach/thread_state.h>
@@ -4574,6 +4575,33 @@ void virtual_map_user_shared_data(void)
 }
 
 
+#if defined(__APPLE__) && defined(__x86_64__)
+/******************************************************************
+ *		rdtsc_counts_continuous_time
+ *
+ * Under Rosetta 2, rdtsc counts nanoseconds of mach_continuous_time, the clock
+ * NtQueryPerformanceCounter reads, so PE code can read the performance counter
+ * without a syscall. Check that the two read the same, rather than assume it:
+ * on Intel, where rdtsc counts CPU cycles, it runs ahead and the check fails.
+ */
+static BOOL rdtsc_counts_continuous_time(void)
+{
+    for (int i = 0; i < 1000; i++)
+    {
+        ULONG lo, hi;
+        ULONGLONG before, after, now;
+
+        __asm__ __volatile__( "rdtsc" : "=a" (lo), "=d" (hi) );
+        before = ((ULONGLONG)hi << 32) | lo;
+        now = mach_continuous_time();
+        __asm__ __volatile__( "rdtsc" : "=a" (lo), "=d" (hi) );
+        after = ((ULONGLONG)hi << 32) | lo;
+        if (now < before || after < now || after - before > 1000000) return FALSE;
+    }
+    return TRUE;
+}
+#endif
+
 /******************************************************************
  *		virtual_init_user_shared_data
  *
@@ -4622,6 +4650,12 @@ void virtual_init_user_shared_data(void)
     }
 
     init_shared_data_cpuinfo( data );
+#if defined(__APPLE__) && defined(__x86_64__)
+    /* A Wine-private flag in a field Windows leaves unused: RtlQueryPerformanceCounter
+     * then reads rdtsc itself. The Qpc fields stay unset, since on Windows they
+     * would say rdtsc counts at QueryPerformanceFrequency, which stays 10 MHz. */
+    if (rdtsc_counts_continuous_time()) data->Spare = 1;
+#endif
     munmap( data, sizeof(*data) );
 }
 
